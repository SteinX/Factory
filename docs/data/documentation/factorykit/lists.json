{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/FactoryKit\/documentation\/FactoryKit"]]},"identifier":{"url":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Lists","interfaceLanguage":"swift"},"abstract":[{"text":"Register multiple services for one protocol and resolve them as an ordered collection.","type":"text"}],"seeAlsoSections":[{"title":"Advanced Topics","generated":true,"identifiers":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/Design","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Modifiers","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Actors","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Modules","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Cycle","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Optionals","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Functional","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Tags"],"anchor":"Advanced-Topics"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/factorykit\/lists"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Most Factory registrations produce one dependency. Some systems need a set of dependencies that all conform to the same protocol, such as observers, plugins, handlers, or feature contributors."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"FactoryList"},{"type":"text","text":" supports that pattern without automatic scanning or runtime discovery. Modules explicitly append their factories to a list, usually from "},{"type":"codeVoice","code":"AutoRegistering"},{"type":"text","text":", and consumers resolve a snapshot of the registered items."}],"type":"paragraph"},{"level":2,"anchor":"Defining-a-List","text":"Defining a List","type":"heading"},{"inlineContent":[{"type":"text","text":"Define a list on a container with "},{"type":"codeVoice","code":"list(scope:)"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["protocol ObserverService: AnyObject {","    func handle()","}","","extension Container {","    var observers: FactoryList<any ObserverService> {","        list(scope: .shared)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The list scope is only the default scope for inline items. It does not change the scope of factories appended by key path."}],"type":"paragraph"},{"level":2,"anchor":"Registering-Factory-Items","text":"Registering Factory Items","type":"heading"},{"inlineContent":[{"type":"text","text":"A module can contribute an existing factory."}],"type":"paragraph"},{"code":["extension Container {","    var analyticsObserver: Factory<any ObserverService> {","        self { AnalyticsObserver() }.cached","    }","","    func registerAnalyticsObserver() {","        observers.append(\\.analyticsObserver)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The contributed item follows "},{"type":"codeVoice","code":"analyticsObserver"},{"type":"text","text":"’s own scope. If that factory is "},{"type":"codeVoice","code":".cached"},{"type":"text","text":", repeated list access reuses the cached instance. If it is unique, each access creates a new instance."}],"type":"paragraph"},{"level":2,"anchor":"Registering-Inline-Items","text":"Registering Inline Items","type":"heading"},{"inlineContent":[{"type":"text","text":"You can also append an inline item."}],"type":"paragraph"},{"code":["extension Container {","    func registerInlineObserver() {","        observers.append(","            FactoryListItem(key: \"inline-observer\") {","                InlineObserver()","            }","            .shared","        )","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"If the inline item does not set a scope, it uses the list default scope. If neither the item nor the list defines a scope, the item behaves as unique."}],"type":"paragraph"},{"level":2,"anchor":"Wiring-Lists","text":"Wiring Lists","type":"heading"},{"inlineContent":[{"type":"text","text":"FactoryList does not scan modules automatically. Call contribution functions from your app or aggregation module."}],"type":"paragraph"},{"code":["extension Container: @retroactive AutoRegistering {","    func autoRegister() {","        registerAnalyticsObserver()","        registerInlineObserver()","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Repeated registration is safe. If the same item key is appended more than once, the first registration wins and later duplicates are ignored."}],"type":"paragraph"},{"level":2,"anchor":"Resolving-a-Snapshot","text":"Resolving a Snapshot","type":"heading"},{"inlineContent":[{"type":"text","text":"Resolving a list returns a snapshot."}],"type":"paragraph"},{"code":["let snapshot = Container.shared.observers()","","for observer in snapshot {","    observer.handle()","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"FactoryListSnapshot"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"RandomAccessCollection"},{"type":"text","text":", so collection APIs such as "},{"type":"codeVoice","code":"map"},{"type":"text","text":", "},{"type":"codeVoice","code":"filter"},{"type":"text","text":", and subscript access are available."}],"type":"paragraph"},{"code":["let first = snapshot[snapshot.startIndex]","let names = snapshot.map { String(describing: type(of: $0)) }"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Accessing an element resolves that item. The snapshot does not store an already materialized array of service instances."}],"type":"paragraph"},{"level":2,"anchor":"Snapshot-Semantics","text":"Snapshot Semantics","type":"heading"},{"inlineContent":[{"type":"text","text":"A snapshot contains the items that were registered when the list was resolved."}],"type":"paragraph"},{"code":["let firstSnapshot = Container.shared.observers()","Container.shared.observers.append(\\.anotherObserver)","let secondSnapshot = Container.shared.observers()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"firstSnapshot"},{"type":"text","text":" does not see "},{"type":"codeVoice","code":"anotherObserver"},{"type":"text","text":". "},{"type":"codeVoice","code":"secondSnapshot"},{"type":"text","text":" does."}],"type":"paragraph"},{"level":2,"anchor":"Lazy-Injection","text":"Lazy Injection","type":"heading"},{"inlineContent":[{"type":"text","text":"Lists can be resolved lazily."}],"type":"paragraph"},{"code":["final class ObserverCenter {","    @LazyInjected(\\.observers) private var observers","","    func emit() {","        for observer in observers {","            observer.handle()","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The lazy wrapper stores one snapshot. Later appends do not change that already injected snapshot."}],"type":"paragraph"},{"level":2,"anchor":"Reset-Behavior","text":"Reset Behavior","type":"heading"},{"inlineContent":[{"type":"text","text":"List registrations are registration state."}],"type":"paragraph"},{"code":["Container.shared.reset(options: .registration)","Container.shared.reset(options: .all)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Both calls clear list registrations. Scope reset keeps list registrations."}],"type":"paragraph"},{"code":["Container.shared.reset(options: .scope)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"FactoryList.reset()"},{"type":"text","text":" to clear one list."}],"type":"paragraph"},{"code":["Container.shared.observers.reset()"],"syntax":"swift","type":"codeListing"}]}],"sections":[],"metadata":{"title":"Service Lists","roleHeading":"Article","modules":[{"name":"FactoryKit"}],"role":"article"},"kind":"article","references":{"doc://FactoryKit/documentation/FactoryKit/Modifiers":{"title":"Factory Modifiers","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Modifiers","kind":"article","url":"\/documentation\/factorykit\/modifiers","abstract":[{"text":"Considerations when defining and redefining a Factory’s behavior.","type":"text"}],"role":"article","type":"topic"},"doc://FactoryKit/documentation/FactoryKit/Tags":{"title":"Tags","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Tags","kind":"article","url":"\/documentation\/factorykit\/tags","abstract":[{"text":"Obtaining a list of dependencies of a given type.","type":"text"}],"role":"article","type":"topic"},"doc://FactoryKit/documentation/FactoryKit/Optionals":{"title":"Optionals and Dynamic Registration","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Optionals","kind":"article","url":"\/documentation\/factorykit\/optionals","abstract":[{"text":"With Factory registrations can be performed at any time.","type":"text"}],"role":"article","type":"topic"},"doc://FactoryKit/documentation/FactoryKit/Modules":{"title":"Modular Development","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Modules","kind":"article","abstract":[{"type":"text","text":"Using Factory in a project with multiple modules."}],"url":"\/documentation\/factorykit\/modules","role":"article","type":"topic"},"doc://FactoryKit/documentation/FactoryKit/Actors":{"url":"\/documentation\/factorykit\/actors","kind":"article","title":"Actors and Actor Isolation","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Actors","type":"topic","abstract":[{"text":"Registering and resolving actors and actor-isolated dependencies.","type":"text"}],"role":"article"},"doc://FactoryKit/documentation/FactoryKit/Functional":{"url":"\/documentation\/factorykit\/functional","kind":"article","title":"Functional Injection","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Functional","type":"topic","abstract":[{"type":"text","text":"Factory can inject more than service classes and structs."}],"role":"article"},"doc://FactoryKit/documentation/FactoryKit/Cycle":{"title":"Resolution Cycles","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Cycle","kind":"article","url":"\/documentation\/factorykit\/cycle","abstract":[{"text":"What’s a resolution cycle, and why should we care?","type":"text"}],"role":"article","type":"topic"},"doc://FactoryKit/documentation/FactoryKit":{"kind":"symbol","role":"collection","type":"topic","title":"FactoryKit","url":"\/documentation\/factorykit","abstract":[{"text":"A modern approach to Container-Based Dependency Injection for Swift and SwiftUI.","type":"text"}],"identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit"},"doc://FactoryKit/documentation/FactoryKit/Design":{"title":"Designing Factory","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Design","kind":"article","url":"\/documentation\/factorykit\/design","abstract":[{"text":"Rationale behind the design decisions made in Factory 1.0 and 2.0","type":"text"}],"role":"article","type":"topic"}}}