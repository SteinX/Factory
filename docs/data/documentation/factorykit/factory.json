{"variants":[{"paths":["\/documentation\/factorykit\/factory"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"A Factory manages the dependency injection process for a specific object or service.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Factory","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Factory"}],"modules":[{"name":"FactoryKit"}],"title":"Factory","roleHeading":"Structure","symbolKind":"struct","externalID":"s:10FactoryKit0A0V"},"topicSections":[{"identifiers":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/Factory\/init(_:key:_:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/Factory\/registration"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/Factory\/callAsFunction()","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Factory\/callAsFunction(factory:)","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Factory\/register(factory:)","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Factory\/resolve()","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Factory\/resolveOnGlobalActor(_:)","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Factory\/resolveOnMainActor()"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true},{"identifiers":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/Factory\/FactoryModifying-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"relationshipsSections":[{"identifiers":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/FactoryModifying","doc:\/\/FactoryKit\/s8SendableP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FactoryKit\/documentation\/Fact