/documentation\/FactoryKit\/SwiftUI","abstract":[{"text":"Defining and using dependencies in SwiftUI.","type":"text"}],"kind":"article","role":"article","type":"topic","title":"SwiftUI","url":"\/documentation\/factorykit\/swiftui"},"doc://FactoryKit/documentation/FactoryKit/Previews":{"identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Previews","abstract":[{"text":"Mocking dependencies for SwiftUI Previews.","type":"text"}],"kind":"article","role":"article","type":"topic","title":"SwiftUI Previews","url":"\/documentation\/factorykit\/previews"}}}