{"hierarchy":{"paths":[["doc:\/\/FactoryKit\/documentation\/FactoryKit"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"role":"article","title":"Service Lists","roleHeading":"Article","modules":[{"name":"FactoryKit"}]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Lists"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Most Factory registrations produce one dependency. Some systems need a set of dependencies that all conform to the same protocol, such as observers, plugins, handlers, or feature contributors."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"FactoryList"},{"text":" supports that pattern without automatic scanning or runtime discovery. Modules explicitly append their factories to a list, usually from ","type":"text"},{"type":"codeVoice","code":"AutoRegistering"},{"text":", and consumers resolve a snapshot of the registered items.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Defining-a-List","level":2,"text":"Defining a List"},{"inlineContent":[{"text":"Define a list on a container with ","type":"text"},{"code":"list(scope:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["protocol ObserverService: AnyObject {","    func handle()","}","","extension Container {","    var observers: FactoryList<any ObserverService> {","        list(scope: .shared)","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The list scope is only the default scope for inline items. It does not change the scope of factories appended by key path."}],"type":"paragraph"},{"type":"heading","anchor":"Registering-Factory-Items","level":2,"text":"Registering Factory Items"},{"inlineContent":[{"text":"A module can contribute an existing factory.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["extension Container {","    var analyticsObserver: Factory<any ObserverService> {","        self { AnalyticsObserver() }.cached","    }","","    func registerAnalyticsObserver() {","        observers.append(\\.analyticsObserver)","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"The contributed item follows ","type":"text"},{"code":"analyticsObserver","type":"codeVoice"},{"text":"’s own scope. If that factory is ","type":"text"},{"code":".cached","type":"codeVoice"},{"text":", repeated list access reuses the cached instance. If it is unique, each access creates a new instance.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Registering-Inline-Items","level":2,"text":"Registering Inline Items"},{"inlineContent":[{"text":"You can also append an inline item.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["extension Container {","    func registerInlineObserver() {","        observers.append(","            FactoryListItem(key: \"inline-observer\") {","                InlineObserver()","            }","            .shared","        )","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"If the inline item does not set a scope, it uses the list default scope. If neither the item nor the list defines a scope, the item behaves as unique."}],"type":"paragraph"},{"type":"heading","anchor":"Wiring-Lists","level":2,"text":"Wiring Lists"},{"inlineContent":[{"text":"FactoryList does not scan modules automatically. Call contribution functions from your app or aggregation module.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["extension Container: @retroactive AutoRegistering {","    func autoRegister() {","        registerAnalyticsObserver()","        registerInlineObserver()","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Repeated registration is safe. If the same item key is appended more than once, the first registration wins and later duplicates are ignored."}],"type":"paragraph"},{"type":"heading","anchor":"Resolving-a-Snapshot","level":2,"text":"Resolving a Snapshot"},{"inlineContent":[{"text":"Resolving a list returns a snapshot.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let snapshot = Container.shared.observers()","","for observer in snapshot {","    observer.handle()","}"],"syntax":"swift"},{"inlineContent":[{"code":"FactoryListSnapshot","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"RandomAccessCollection","type":"codeVoice"},{"text":", so collection APIs such as ","type":"text"},{"code":"map","type":"codeVoice"},{"text":", ","type":"text"},{"code":"filter","type":"codeVoice"},{"text":", and subscript access are available.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let first = snapshot[snapshot.startIndex]","let names = snapshot.map { String(describing: type(of: $0)) }"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Accessing an element resolves that item. The snapshot does not store an already materialized array of service instances."}],"type":"paragraph"},{"type":"heading","anchor":"Snapshot-Semantics","level":2,"text":"Snapshot Semantics"},{"inlineContent":[{"type":"text","text":"A snapshot contains the items that were registered when the list was resolved."}],"type":"paragraph"},{"type":"codeListing","code":["let firstSnapshot = Container.shared.observers()","Container.shared.observers.append(\\.anotherObserver)","let secondSnapshot = Container.shared.observers()"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"firstSnapshot"},{"type":"text","text":" does not see "},{"type":"codeVoice","code":"anotherObserver"},{"type":"text","text":". "},{"type":"codeVoice","code":"secondSnapshot"},{"type":"text","text":" does."}],"type":"paragraph"},{"type":"heading","anchor":"Lazy-Injection","level":2,"text":"Lazy Injection"},{"inlineContent":[{"type":"text","text":"Lists can be resolved lazily."}],"type":"paragraph"},{"type":"codeListing","code":["final class ObserverCenter {","    @LazyInjected(\\.observers) private var observers","","    func emit() {","        for observer in observers {","            observer.handle()","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"The lazy wrapper stores one snapshot. Later appends do not change that already injected snapshot.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Reset-Behavior","level":2,"text":"Reset Behavior"},{"inlineContent":[{"type":"text","text":"List registrations are registration state."}],"type":"paragraph"},{"type":"codeListing","code":["Container.shared.reset(options: .registration)","Container.shared.reset(options: .all)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Both calls clear list registrations. Scope reset keeps list registrations."}],"type":"paragraph"},{"type":"codeListing","code":["Container.shared.reset(options: .scope)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"FactoryList.reset()","type":"codeVoice"},{"type":"text","text":" to clear one list."}],"type":"paragraph"},{"type":"codeListing","code":["Container.shared.observers.reset()"],"syntax":"swift"}]}],"kind":"article","variants":[{"paths":["\/documentation\/factorykit\/lists"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Register multiple services for one protocol and resolve them as an ordered collection.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/Modifiers","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Actors","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Modules","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Scenes","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Cycle","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Optionals","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Functional","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Tags"],"anchor":"Advanced-Topics","titl